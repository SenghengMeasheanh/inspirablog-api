{
  "name": "inspirablog-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "db:seed": "tsx ./src/db/seeds/index.ts",
    "create-user": "tsx ./src/db/seeds/user.ts",
    "db:generate-better-auth": "npx @better-auth/cli@latest generate --config ./src/better-auth/config.ts --output ./src/better-auth/generated-schema.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.3",
    "@neondatabase/serverless": "^1.0.1",
    "@react-email/components": "^0.5.5",
    "better-auth": "^1.3.17",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.8",
    "resend": "^6.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@better-auth/cli": "1.3.17",
    "@biomejs/biome": "2.2.4",
    "@types/react": "19.1.13",
    "dotenv": "17.2.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "wrangler": "^4.4.0"
  }
}
